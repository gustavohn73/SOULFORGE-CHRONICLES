# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/soulforge

# AI Configuration
AI_MASTER_PROVIDER=claude  # Options: claude, gemini, none
AI_MASTER_API_KEY=your-api-key-here

# Ollama (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Server Configuration
SECRET_KEY=change-me-in-production
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Game Settings
TICK_RATE=20
MAX_PLAYERS_PER_LOOP=10
LOOP_MIN_DURATION=900
LOOP_MAX_DURATION=3600

# Map Settings
MAP_WIDTH=80
MAP_HEIGHT=60
DEFAULT_FOV_RADIUS=8

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/soulforge.log
